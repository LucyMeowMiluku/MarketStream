KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DATABASE_URL=postgresql+psycopg://marketstream:marketstream@localhost:5432/marketstream
# Required for the live factor engine: COLD_START, VERIFIED_BACKFILL, or RESTORE.
FACTOR_BASELINE_STARTUP_MODE=COLD_START
FACTOR_ENGINE_VERSION=marketstream-0.1.0
FACTOR_CHECKPOINT_DIR=/var/lib/marketstream/baseline-checkpoints
